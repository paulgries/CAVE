{
  "name": "cave",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paulgries/CAVE/issues"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "gts": "^7.0.0",
    "jest": "^30.2.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
